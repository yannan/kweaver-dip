PORT=3000

OPENCLAW_GATEWAY_PROTOCOL=ws            # 必填，OpenClaw 网关协议
OPENCLAW_GATEWAY_HOST=127.0.0.1         # 必填，OpenClaw 网关地址
OPENCLAW_GATEWAY_PORT=19001             # 必填，OpenClaw 网关端口
OPENCLAW_GATEWAY_TOKEN=                 # 必填，OpenClaw 网关认证 Token
OPENCLAW_GATEWAY_TIMEOUT_MS=5000

KWEAVER_BASE_URL=                       # 可选，KWeaver 服务地址
KWEAVER_TOKEN=                          # 可选，KWeaver Token

OTEL_TRACE_ENABLED=true                 # 可选，是否开启 trace；false 且 OTEL_LOG_ENABLED=false 时不会初始化 NodeSDK
OTEL_SERVICE_NAME=studio                # 可选，trace/log 后端中显示的服务名
OTEL_SERVICE_VERSION=local-dev          # 可选，服务版本；本地调试可写 local-dev，线上通常对应镜像 tag 或 git sha
OTEL_ENVIRONMENT=development            # 可选，部署环境标识，用于区分 development / test / production
OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol-contrib:4318 # 可选，OTLP/HTTP 基础地址；代码会自动补 /v1/traces 和 /v1/logs
OTEL_TRACE_EXPORTER=otlp                # 可选，trace exporter：otlp | local | both
OTEL_TRACE_SAMPLING_RATE=1.0            # 可选，trace 采样率，范围 0.0 到 1.0；1.0 表示全量采样
OTEL_LOG_ENABLED=false                  # 可选，是否开启 OTel logs 管线；只影响 logRecordProcessor/exporter，不影响控制台 diag 日志
OTEL_LOG_LEVEL=info                     # 可选，OTel diag 控制台日志级别：none | error | warn | info | debug | verbose | all
OTEL_LOG_EXPORTER=otlp                  # 可选，OTel logs exporter：otlp | local | both；仅在 OTEL_LOG_ENABLED=true 时生效

# 以下配置仅在 NODE_ENV=development 时有效
OAUTH_MOCK_USER_ID=                     # 可选，用于开发环境的 OAuth 模拟用户 ID
KWEAVER_HYDRA_ADMIN_URL=                # 可选，Hydra 管理后台地址，用于 Token 内省
